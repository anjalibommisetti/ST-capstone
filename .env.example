# TestFusion Environment Variables Configuration Example

# --- Backend Configuration ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=default

# Embedded Database (Default: Embedded H2 with MySQL dialect mode - Zero Setup)
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/testfusion;MODE=MySQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH
SPRING_DATASOURCE_DRIVER=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# Optional MySQL Production Database (activate with SPRING_PROFILES_ACTIVE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=testfusion_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Isolated JVM Test Runner Sandbox Limits
TESTRUNNER_TIMEOUT_SECONDS=6
TESTRUNNER_MEMORY_MB=128
TESTRUNNER_SANDBOX_DIR=./sandbox_workspaces

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:8080

